{
  "expo": {
    "name": "Plate Spinner",
    "slug": "hw10-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/plate-icon.png",
    "scheme": "hw10app",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF8EE",
        "foregroundImage": "./assets/images/plate-mark.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/plate-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8EE",
          "dark": {
            "backgroundColor": "#1C1B19"
          },
          "image": "./assets/images/plate-mark.png",
          "imageWidth": 130
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
